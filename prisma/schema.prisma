datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

model User {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  password          String? // Optional for passwordless logins
  phone             String?
  photoUrl          String?       @db.VarChar(500)
  age               Int?
  height            String?
  weight            String?
  bloodGroup        String?
  insuranceProvider String?
  healthConditions  String?       @db.Text
  role              Role          @default(PATIENT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointments      Appointment[]
}

model HospitalGroup {
  id         String   @id @default(uuid())
  name       String   @unique
  photoUrl   String?  @db.VarChar(500)
  aboutUs    String?  @db.Text
  isFeatured Boolean  @default(false) // Shown in "Top Hospital Groups" on homepage (max 4, enforced in app/actions/admin.ts)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clinics    Clinic[]

  @@index([isFeatured])
}

model Clinic {
  id              String        @id @default(uuid())
  hospitalGroupId String
  hospitalGroup   HospitalGroup @relation(fields: [hospitalGroupId], references: [id], onDelete: Cascade)
  name            String // Branch name (e.g. Dubai Hills Hospital, Jumeirah Clinic)
  city            String // Dubai, Sharjah, Ajman
  email           String        @default("info@clinic.com")
  phone           String        @default("+971 800 7777")
  address         String?       @db.Text
  photoUrl        String?       @db.VarChar(500)
  aboutUs         String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  doctors         Doctor[]
  appointments    Appointment[]

  @@unique([hospitalGroupId, name])
  @@index([city])
}

model Specialty {
  id        String   @id @default(uuid())
  name      String   @unique
  iconName  String   @default("Activity")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctors   Doctor[]
}

model Doctor {
  id              String        @id @default(uuid())
  name            String
  slug            String        @unique
  specialtyId     String?
  specialtyRef    Specialty?    @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  specialty       String // Fallback/Display compatibility
  type            String        @default("Specialist")
  areaOfExpertise String?       @db.Text
  experience      String?       @db.VarChar(100) // Free text, e.g. "15" or "15+ Years"
  photoUrl        String?       @db.VarChar(500)
  rating          Float         @default(5.0)
  reviews         Int           @default(0)
  email           String        @unique
  clinics         Clinic[]
  languages       String        @default("English")
  gender          String        @default("Male")
  fee             Int
  bio             String        @db.Text
  qualifications  String?       @db.Text
  status          String        @default("Active") // Active, Pending
  isFeatured      Boolean       @default(false) // Shown in "Featured doctors" on homepage (max 4, enforced in app/actions/doctors.ts)
  availableDays   String        @default("Mon - Fri")
  availableTime   String        @default("09:00 AM - 05:00 PM")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  reviewsList     Review[]

  @@index([status])
  @@index([specialty])
  @@index([type])
  @@index([isFeatured])
}

model Appointment {
  id           String            @id @default(uuid())
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId     String?
  clinic       Clinic?           @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  date         String // Format: YYYY-MM-DD
  timeSlot     String // Format: HH:MM AM/PM
  patientName  String
  patientEmail String
  patientPhone String
  reason       String?           @db.Text
  status       AppointmentStatus @default(CONFIRMED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([doctorId])
}

model Review {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientName String
  rating      Int // 1 to 5
  comment     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([doctorId])
}
