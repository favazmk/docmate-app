# ============================================================
# DocMate - Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# Your Hostinger MySQL connection string
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_HOSTINGER_HOST:3306/YOUR_DB_NAME"

# --- NextAuth ---
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
# The URL your app is deployed at (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- SMTP Email (for appointment notifications) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
# Use a Gmail App Password, NOT your real Gmail password
SMTP_PASS="xxxx xxxx xxxx xxxx"
ADMIN_EMAIL="admin-notification-recipient@example.com"

# --- Analytics (both optional) ---
# Neither value is a secret: both appear in the page source of every tracked
# site. Omit them and the app falls back to the production IDs hardcoded in
# components/Analytics.tsx. Set either to "" to switch that tag off.
#
# Google Tag Manager container ID - tagmanager.google.com, top right.
# This is the ONLY tag the site loads. GA4 is configured as a tag inside the
# container, so the site must not load gtag.js as well or every pageview is
# counted twice.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
#
# GA4 Measurement ID - GA4 > Admin > Data streams > Web.
# NOT used to load anything. It only names the property for the
# `ga-disable-<ID>` flag that keeps admin-dashboard traffic out of the reports.
# Must match the property the GTM container reports into, or admin visits leak
# into the numbers.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
